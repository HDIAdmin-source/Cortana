{
  "name": "@cortana/bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "register": "tsx --env-file=.env src/register.ts",
    "start": "tsx src/index.ts",
    "register:prod": "tsx src/register.ts",
    "rsi-smoke": "tsx scripts/rsi-smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cortana/shared": "workspace:*",
    "@supabase/supabase-js": "^2.45.0",
    "discord.js": "^14.16.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
