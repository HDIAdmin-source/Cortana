# Copy this file to .env (same folder) and fill it in. Never commit .env.
# Use the TEST Discord server and a LOCAL or TEST Supabase project while developing.

# Discord Developer Portal > your application > Bot > Reset Token
DISCORD_TOKEN=
# Discord Developer Portal > your application > General Information > Application ID
DISCORD_CLIENT_ID=
# The server the bot works in (Developer Mode on, right-click the server icon > Copy Server ID)
DISCORD_GUILD_ID=

# Optional (right-click > Copy ID). Leave blank to skip that message.
# Where role mismatches and promotion proposals are posted:
ADMIN_CHANNEL_ID=
# Where new /enlist applications are posted:
RECRUITMENT_CHANNEL_ID=
# Role pinged about new applications:
RECRUITER_ROLE_ID=

# Supabase: for local development, `pnpm db:start` prints these.
# The service role key bypasses row-level security: keep it secret, server-side only.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
