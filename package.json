{
  "name": "cortana",
  "private": true,
  "description": "HDI Cortana: one backend for the website, Discord bot, phone app and overlay. See docs/SPEC.md.",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "dev:web": "pnpm --filter @cortana/web dev",
    "dev:bot": "pnpm --filter @cortana/bot dev",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "^22.0.0",
    "supabase": "^2.30.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
